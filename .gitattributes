# Auto detect text files and perform LF normalization
* text=auto

# Keep web source files stable across Windows/macOS/Linux editors.
.gitattributes text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
